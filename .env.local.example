# Required for document explanation, First Day extraction, translation, and the grounded assistant.
GROQ_API_KEY=

# Optional allowlisted overrides. Defaults are shown.
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_TEXT_MODEL=openai/gpt-oss-20b

# Required in preview/production for distributed API rate limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_SALT=
RATE_LIMIT_NAMESPACE=local

# Optional: higher-quality server-side speech. Browser speech remains available.
ELEVENLABS_API_KEY=

# Optional: local help search. The curated resource directory works without it.
PERPLEXITY_API_KEY=
